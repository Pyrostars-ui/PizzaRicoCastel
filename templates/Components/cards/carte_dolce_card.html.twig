{# templates/Components/cards/carte_dolce_card.html.twig #}
<article class="menu-item-card flex flex-col rounded-xl bg-surface-container-low hover:bg-surface-container transition-all duration-300 p-5 gap-4 shadow-md justify-between border border-outline-variant/30 group hover:-translate-y-1"
         data-category="dessert"
         data-title="{{ dolce.name|lower }}">
    <div class="flex flex-col gap-3">
        <div class="w-full h-36 rounded-lg bg-surface-container-high overflow-hidden relative">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                 src="{{ dolce.image }}"
                 alt="{{ dolce.name }} fait maison par Pizza Rico"
                 loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low/60 via-transparent to-transparent"></div>
            <span class="absolute top-2 left-2 px-2 py-0.5 rounded bg-surface/85 backdrop-blur-md text-secondary font-label-sm text-label-sm font-semibold border border-outline-variant/30">
                {{ dolce.badge }}
            </span>
        </div>
        <div class="flex items-start justify-between gap-2">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold group-hover:text-secondary transition-colors">{{ dolce.name }}</h3>
            <span class="font-title text-title text-secondary font-bold shrink-0">
                {{ dolce.price|number_format(2, '.', '') }} €
            </span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
            {{ dolce.description }}
        </p>
    </div>
    <button type="button"
            class="w-full py-2.5 px-3 rounded-lg bg-surface-container-high hover:bg-primary-container hover:text-on-primary-container text-secondary font-label-md text-label-md font-semibold transition-all flex items-center justify-center gap-1.5 active:scale-[0.99] border border-outline-variant/20 shadow-sm"
            data-action="add-to-cart" data-name="{{ dolce.name }}" data-explicit-price="{{ dolce.price }}">
        <span class="material-symbols-outlined text-[16px]">add</span>
        <span>Ajouter</span>
    </button>
</article>
