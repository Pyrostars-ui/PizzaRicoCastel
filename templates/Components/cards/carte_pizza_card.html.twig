{# templates/Components/cards/carte_pizza_card.html.twig #}
{# Déduction intelligente de la base (tomate ou crème) #}
{% set ingLower = pizza.ingredient|lower %}
{% set nameLower = pizza.name|lower %}
{% set isCreme = ('crème' in ingLower or 'creme' in ingLower or 'tartufata' in nameLower or 'quattro formaggi' in nameLower) %}
{% set pizzaBase = isCreme ? 'creme' : 'tomate' %}

{# Déduction des catégories pour les filtres interactifs #}
{% set categories = [] %}
{% if pizza.isSpecial %}{% set categories = categories|merge(['specialite']) %}{% endif %}
{% if 'truffe' in ingLower or 'truffe' in nameLower or 'tartufata' in nameLower %}{% set categories = categories|merge(['truffe']) %}{% endif %}
{% if ('burrata' in ingLower or 'veggie' in nameLower or 'quattro' in nameLower or 'margherita' in nameLower) and ('jambon' not in ingLower and 'spianata' not in ingLower and 'parma' not in nameLower) %}{% set categories = categories|merge(['veggie']) %}{% endif %}
{% if 'reine' in nameLower or 'margherita' in nameLower or 'calzone' in nameLower or 'quattro' in nameLower %}{% set categories = categories|merge(['classique']) %}{% endif %}
{% if categories is empty %}{% set categories = ['classique'] %}{% endif %}
{% set catString = categories|join(' ') %}

{# Détermination de l'image avec fallback haute définition #}
{% if pizza.image %}
    {% set pImageUrl = pizza.image starts with 'http' ? pizza.image : asset('images/pizzas/' ~ pizza.image) %}
{% else %}
    {% set pImageUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuBV9vUwr75BYes7VOSy2GN9_Bba2I0qLZaCU-2Dt68k2huQHo0EH7YBH1DTrt9y_eLgSujqj_-_2owFyGp1pKBWE-usiHyzlpwkjGwBsHe4tIK2yf1E58e4ef1SmUFJkdhDu4z8H_TT7v398RYfjfU29Ah7lA3NY90PW-XUfdUnWtb-z7F-IHK5rVrUzjvxXsEGkyD26QrR1kus6vtQhzKGRuTM-j_P2DZ3bTWaiIHNuT1GmWCaybWYQw' %}
{% endif %}

{# Calcul dynamique de l'écart de prix entre 33cm et 29cm #}
{% set deltaPrice = (pizza.priceLarge - pizza.priceMedium) %}
{% set deltaFormatted = deltaPrice|number_format(2, '.', '') %}

<article class="menu-item-card flex flex-col rounded-xl bg-surface-container-low hover:bg-surface-container transition-all duration-300 shadow-md hover:-translate-y-1 overflow-hidden border border-outline-variant/30 group"
         data-base="{{ pizzaBase }}"
         data-category="{{ catString }}"
         data-title="{{ pizza.name|lower }} {{ pizza.ingredient|lower }}">
    <!-- Image 16:9 avec Badges Radicaux -->
    <div class="relative w-full h-52 bg-surface-container-high overflow-hidden">
        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
             src="{{ pImageUrl }}"
             alt="{{ pizza.name }} cuite au four à bois 450°C à Castelsarrasin"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent"></div>

        <!-- Badge Type / Signature -->
        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-md {{ pizza.isSpecial ? 'bg-secondary text-on-secondary' : 'bg-surface-container-highest text-on-surface' }}">
            {% if 'tartufata' in nameLower %}
                Signature Chef
            {% elseif 'margherita' in nameLower %}
                STG Tradition
            {% elseif 'diavola' in nameLower %}
                Piquant Modéré
            {% elseif 'burrata' in nameLower %}
                Burrata 125g
            {% elseif pizza.isSpecial %}
                Sélection Rico
            {% else %}
                Classique Revisité
            {% endif %}
        </span>

        <!-- Badge Four 450°C -->
        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-surface/85 backdrop-blur-md text-secondary font-label-sm text-label-sm flex items-center gap-1 border border-outline-variant/30">
            <span class="material-symbols-outlined text-[14px]">local_fire_department</span> 450°C
        </span>
    </div>

    <!-- Contenu et Description -->
    <div class="p-5 flex flex-col flex-1 justify-between gap-4">
        <div class="flex flex-col gap-2">
            <div class="flex items-start justify-between gap-2">
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold group-hover:text-secondary transition-colors">{{ pizza.name }}</h3>
                <span class="item-price font-title text-title text-secondary font-bold shrink-0" data-base-price="{{ pizza.priceMedium|number_format(2, '.', '') }}">
                    {{ pizza.priceMedium|number_format(2, '.', '') }} €
                </span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                {{ pizza.ingredient }}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="px-2 py-0.5 rounded {{ isCreme ? 'bg-secondary-container/30 text-secondary' : 'bg-primary-container/20 text-primary' }} font-label-sm text-label-sm font-semibold">
                    {{ isCreme ? 'Base Crème' : 'San Marzano DOP' }}
                </span>
                <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm">
                    Levain 72h
                </span>
                {% if 'truffe' in ingLower or 'truffe' in nameLower %}
                    <span class="px-2 py-0.5 rounded bg-tertiary-container/30 text-tertiary font-label-sm text-label-sm font-semibold">
                        Truffe Noire
                    </span>
                {% endif %}
            </div>
        </div>

        <!-- Sizing & Add To Cart CTA -->
        <div class="flex flex-col gap-3 pt-3 border-t border-outline-variant/20">
            <!-- Bi-Format Selector 29cm vs 33cm avec recalcul dynamique -->
            <div class="grid grid-cols-2 p-1 bg-surface-container-high rounded-lg text-center border border-outline-variant/30">
                <button type="button"
                        class="size-btn active py-1.5 rounded-md font-label-sm text-label-sm bg-surface-container text-secondary font-semibold transition-all"
                        data-action="select-size" data-extra-price="0">
                    Petite 29cm
                </button>
                <button type="button"
                        class="size-btn py-1.5 rounded-md font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface font-semibold transition-all"
                        data-action="select-size" data-extra-price="{{ deltaFormatted }}">
                    Grande 33cm (+{{ deltaFormatted }}€)
                </button>
            </div>

            <!-- Bouton d'ajout au panier -->
            <button type="button"
                    class="w-full py-2.5 px-4 rounded-lg bg-primary-container text-on-primary-container font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 hover:brightness-110 active:scale-[0.99] transition-all shadow-[0_4px_16px_rgba(239,101,65,0.35)] ember-glow"
                    data-action="add-to-cart" data-name="{{ pizza.name }}">
                <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                <span>Ajouter au panier</span>
            </button>
        </div>
    </div>
</article>
