{# templates/Components/cards/card_style_04.html.twig #}
{# Style 04 : Expérimental Typographique & Minimalisme Radical (ex: Parma & Diavola) #}

{% set cardKey = cardKey|default('a') %}
{% set pPriceMedium = pizza.priceMedium|number_format(2, '.', '') ~ '€' %}
{% set pPriceLarge = pizza.priceLarge|number_format(2, '.', '') ~ '€' %}
{% set wmMedium = pizza.priceMedium|number_format(1, '.', '') %}
{% set wmLarge = pizza.priceLarge|number_format(1, '.', '') %}

{% if pizza.image %}
    {% set pImageUrl = pizza.image starts with 'http' ? pizza.image : asset('images/pizzas/' ~ pizza.image) %}
{% else %}
    {% set pImageUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuAAoBjCC9T0ejLP7Uj2hQqEe9tqhdp27YYjWzcYiZifcZVCsTRvkn5yOkKgeEW2lOvbGK4MtqyX4FdpoUR7dHVpB4W2rvDJiGmLaeegjKTauJDfvZ159VOK9ra0G3y7YpIiKjH2DMPS_0O3xRtMkJp_n7lyv2zX_tKoPh0UsDt8bSCywVPqHm0fT-5ZkNA9ikxowb3QEokouErAplWQIZa3_kFtNpH6a3r--dzq4DkN1RuSqPDoZpD1qHo91ucFST8-DoMGSjgQfzgk' %}
{% endif %}

<div class="relative rounded-3xl bg-surface-container-low border border-outline-variant/30 p-6 sm:p-8 overflow-hidden group hover:border-secondary transition-all duration-300 pizza-showcase-item"
     data-pizza-card
     data-pizza-id="{{ pizza.id }}"
     data-pizza-name="{{ pizza.name }}"
     data-pizza-ingredients="{{ pizza.ingredient }}"
     data-pizza-category="{{ categoryFilter|default('tomate') }}"
     data-architecture-style="04"
     data-price-medium="{{ pizza.priceMedium }}"
     data-price-large="{{ pizza.priceLarge }}">

    <!-- Giant stylized display price watermark background -->
    <span class="absolute -top-6 -right-4 font-display text-[9rem] font-black text-surface-container-highest/30 select-none pointer-events-none tracking-tighter"
          id="rad-watermark-{{ cardKey }}">
        {{ wmMedium }}
    </span>

    <!-- Header with Oversized Italian Naming -->
    <div class="relative z-10 space-y-2 mb-6">
        <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full {{ cardKey == 'a' ? 'bg-secondary/20 text-secondary' : 'bg-primary-container/20 text-primary-fixed' }} text-[11px] font-bold tracking-widest uppercase">
                {{ tagEdition|default('Édition Spéciale') }}
            </span>
            <span class="inline-flex items-center gap-1 text-primary-fixed text-xs font-mono font-bold">
                <span class="material-symbols-outlined text-sm text-primary-container flame-active">local_fire_department</span> 450°C
            </span>
        </div>
        <h4 class="font-display text-3xl sm:text-4xl font-black text-on-surface tracking-tight group-hover:text-secondary transition-colors">
            {{ pizza.name }}
        </h4>
        <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
            {{ pizza.ingredient }}
        </p>
    </div>

    <!-- Radical Pizza Stage with organic cut border -->
    <div class="relative z-10 w-full h-64 rounded-2xl overflow-hidden mb-6 subtle-hairline bg-surface-container">
        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
             src="{{ pImageUrl }}"
             alt="{{ pizza.name }} édition radicale">
        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent"></div>
        <div class="absolute bottom-3 left-3 px-3 py-1 rounded-lg bg-surface-container-lowest/90 backdrop-blur-md text-xs font-mono {{ cardKey == 'a' ? 'text-secondary' : 'text-primary' }}">
            {{ stageBadge|default('Sole de brique volcanique') }}
        </div>
    </div>

    <!-- Avant-Garde Minimalist Size Radio Slider -->
    <div class="relative z-10 flex items-center justify-between gap-4 py-3 border-y border-outline-variant/30 mb-6">
        <div class="flex items-center gap-2">
            <button type="button"
                    class="rad-btn-{{ cardKey }} active px-3 py-1 rounded-md text-xs font-bold font-mono {{ cardKey == 'a' ? 'bg-secondary text-surface-container-lowest' : 'bg-primary-container text-white' }} transition-all"
                    data-action="rad-size" data-key="{{ cardKey }}" data-size="29cm" data-price="{{ pPriceMedium }}" data-watermark="{{ wmMedium }}">
                Ø 29 CM
            </button>
            <button type="button"
                    class="rad-btn-{{ cardKey }} px-3 py-1 rounded-md text-xs font-bold font-mono text-on-surface-variant hover:text-white transition-all"
                    data-action="rad-size" data-key="{{ cardKey }}" data-size="33cm" data-price="{{ pPriceLarge }}" data-watermark="{{ wmLarge }}">
                Ø 33 CM
            </button>
        </div>
        <div class="text-right">
            <span class="font-display text-2xl font-black {{ cardKey == 'a' ? 'text-secondary' : 'text-primary' }}" id="rad-price-{{ cardKey }}">{{ pPriceMedium }}</span>
        </div>
    </div>

    <!-- Geometric CTA Button -->
    <button type="button"
            class="relative z-10 w-full py-4 rounded-xl bg-surface-container-high hover:bg-primary-container text-white border border-outline-variant/50 hover:border-transparent font-label-lg text-label-lg font-bold transition-all duration-300 flex items-center justify-between px-6 group/btn active:scale-95"
            data-action="add-to-cart" data-name="{{ pizza.name }}" data-price-source="rad-price-{{ cardKey }}" data-default-price="{{ pPriceMedium }}" data-size-label="Calibre sélectionné">
        <span>AJOUTER À MA COMMANDE</span>
        <span class="material-symbols-outlined group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
    </button>
</div>
