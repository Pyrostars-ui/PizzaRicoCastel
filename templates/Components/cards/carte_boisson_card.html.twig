{# templates/Components/cards/carte_boisson_card.html.twig #}
{% set catLower = boisson.category|default('')|lower %}
{% set nameLower = boisson.name|lower %}
{% if 'bière' in catLower or 'biere' in catLower or 'moretti' in nameLower or 'peroni' in nameLower or 'heineken' in nameLower or 'desperados' in nameLower %}
    {% set icon = 'sports_bar' %}
    {% set iconColor = 'text-secondary' %}
{% elseif 'vin' in catLower or 'lambrusco' in nameLower or 'chianti' in nameLower or 'bardolino' in nameLower %}
    {% set icon = 'wine_bar' %}
    {% set iconColor = 'text-primary' %}
{% elseif 'digestif' in catLower or 'limoncello' in nameLower %}
    {% set icon = 'liquor' %}
    {% set iconColor = 'text-secondary' %}
{% else %}
    {% set icon = 'local_drink' %}
    {% set iconColor = 'text-tertiary' %}
{% endif %}

{% set boissonDisplayName = boisson.name ~ (boisson.capacity ? ' (' ~ boisson.capacity ~ ')' : '') %}

<div class="menu-item-card p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-all flex items-center justify-between gap-4 border border-outline-variant/30 group"
     data-category="boisson"
     data-title="{{ boisson.name|lower }} {{ boisson.category|default('')|lower }}">
    <div class="flex items-center gap-3 min-w-0">
        <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center shrink-0 border border-outline-variant/20 {{ iconColor }}">
            <span class="material-symbols-outlined text-[24px]">{{ icon }}</span>
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-title text-title text-on-surface truncate font-semibold group-hover:text-secondary transition-colors">{{ boisson.name }}</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant truncate">
                {{ boisson.category|default('Rafraîchissement') }}{% if boisson.capacity %} • {{ boisson.capacity }}{% endif %}
            </span>
        </div>
    </div>
    <div class="flex items-center gap-3 shrink-0">
        <span class="font-title text-title text-secondary font-bold">{{ boisson.price|number_format(2, '.', '') }} €</span>
        <button type="button"
                aria-label="Ajouter {{ boissonDisplayName }} au panier"
                class="w-9 h-9 rounded-lg bg-surface-container-high hover:bg-primary-container hover:text-on-primary-container text-secondary flex items-center justify-center transition-all active:scale-95 border border-outline-variant/20 shadow-sm"
                data-action="add-to-cart" data-name="{{ boissonDisplayName }}" data-explicit-price="{{ boisson.price }}">
            <span class="material-symbols-outlined text-[18px]">add</span>
        </button>
    </div>
</div>
