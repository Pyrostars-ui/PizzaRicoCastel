                <span class="material-symbols-outlined text-[18px]">restaurant_menu</span>
            </a>
            <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-md rounded-lg bg-surface-container text-secondary hover:bg-surface-container-highest hover:text-secondary-fixed transition-colors font-label-lg text-label-lg border border-secondary/20"
               href="tel:0563321443">
                <span class="material-symbols-outlined text-[18px]">call</span>
                <span>Commander par Téléphone</span>
            </a>
        </div>
