{# templates/Components/about/cta_banner.html.twig #}
<!-- High-Impact Artisanal CTA Banner -->
<section class="relative w-full py-space-xl lg:py-28 px-6 lg:px-12 bg-surface overflow-hidden">
    <!-- Subtle Ambient Radial Glow -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[45rem] h-[25rem] bg-primary-container/10 rounded-full blur-[140px]"></div>
    </div>
    <div class="relative max-w-5xl mx-auto rounded-xl p-space-lg lg:p-space-xl bg-surface-container-high/60 backdrop-blur-xl shadow-2xl flex flex-col md:flex-row items-center justify-between gap-space-xl border border-outline-variant/20">
        <div class="flex flex-col max-w-xl text-left">
            <div class="inline-flex items-center gap-space-xs text-secondary mb-space-xs font-label-sm text-label-sm uppercase tracking-widest">
                <span class="w-2 h-2 rounded-full bg-secondary"></span>
