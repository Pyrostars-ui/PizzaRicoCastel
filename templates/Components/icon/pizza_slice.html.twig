{# Composant icône SVG réutilisable : Part de pizza fondante (style illustration line-art) #}
<svg
    viewBox="0 0 92 86"
    width="{{ size|default('1.35em') }}"
    height="{{ size|default('1.35em') }}"
    class="{{ class|default('me-2 align-middle') }}"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
>
    <g stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
        {# Croûte roulée supérieure et spirale droite #}
        <path d="M 40 7 C 40 3, 43 2, 47 3 C 54 4, 62 7, 68 9" />
        <path d="M 73 12 C 78 14, 83 17, 86 20 C 90 24, 90 30, 85 33 C 81 35, 75 33, 73 28 C 72 24, 75 20, 80 20 C 84 20, 86 24, 84 28 C 83 30, 80 30, 78 28" />
        <path d="M 40 7 C 39 10, 41 13, 45 14 L 54 16" />
        <path d="M 60 17 C 66 19, 71 23, 74 29" />

        {# Encoches de la croûte #}
        <path d="M 45 8 L 45 13" />
        <path d="M 55 7 C 53 8, 52 10, 52 12" />
        <path d="M 61 8 C 59 10, 58 13, 58 16" />
        <path d="M 71 16 C 69 18, 67 20, 67 22" />

        {# Bord supérieur gauche de la part #}
        <path d="M 43 13 C 34 20, 20 31, 11 43" />

        {# Fromage fondant et goutte étirée en bas à gauche #}
        <path d="M 8 48 C 5 52, 4 56, 5 59 C 6 61, 6 63, 4 68 C 2 73, 2 79, 5 82 C 8 83, 11 82, 12 79 C 13 74, 11 67, 10 61 C 10 58, 17 55, 22 52 C 23 56, 24 59, 27 59 C 30 59, 31 54, 32 45 C 36 42, 43 43, 47 39 C 56 38, 66 34, 74 28" />

        {# Reflets intérieurs dans la goutte de fromage #}
        <path d="M 10 52 C 7 55, 7 57, 8 59" stroke-width="3" />
        <path d="M 9 72 C 10 76, 9 78, 7 79" stroke-width="2.8" />

        {# Bord inférieur droit de la pâte #}
        <path d="M 32 46 C 44 43, 56 39, 66 35" />
        <path d="M 76 35 L 84 33" />

        {# Petits traits d'herbes / origan #}
        <path d="M 35 23 L 37 22" stroke-width="3" />
        <path d="M 55 21 L 57 19" stroke-width="3" />
        <path d="M 43 26 L 46 26" stroke-width="3" />
        <path d="M 25 32 L 27 30" stroke-width="3" />
        <path d="M 33 35 L 35 36" stroke-width="3" />
        <path d="M 42 35 L 44 33" stroke-width="3" />
        <path d="M 64 29 L 67 28" stroke-width="3" />
    </g>

    {# Rondelles de pepperoni pleines #}
    <ellipse cx="45" cy="20" rx="6.5" ry="3.8" transform="rotate(-6 45 20)" fill="currentColor" />
    <path d="M 60 19 C 58 21, 61 25, 66 25 C 70 25, 72 23, 70 21 Z" fill="currentColor" />
    <ellipse cx="34" cy="29" rx="6.8" ry="4" transform="rotate(-14 34 29)" fill="currentColor" />
    <ellipse cx="53" cy="29" rx="6.8" ry="3.8" transform="rotate(-6 53 29)" fill="currentColor" />
    <ellipse cx="22" cy="39" rx="6.2" ry="3.6" transform="rotate(-16 22 39)" fill="currentColor" />
</svg>
