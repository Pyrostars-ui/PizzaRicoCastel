{# templates/Components/cart/sticky_cart_sidebar.html.twig #}
<!-- Right Side Sticky Basket / Click & Collect Order Summary -->
<aside id="cart-sidebar" data-cart-sidebar aria-label="Panier et commande" class="sticky top-28 lg:top-36 flex flex-col gap-6">
    <!-- Cart Card -->
    <div class="rounded-2xl bg-surface-container-low p-6 shadow-xl flex flex-col gap-5 border border-outline-variant/30">
        <!-- Cart Header -->
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-[22px]">shopping_bag</span>
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Votre Commande</h2>
            </div>
            <span class="px-2.5 py-0.5 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm font-bold ember-glow" id="cartCountBadge">
                0 article
            </span>
        </div>

        <!-- Pickup Time Widget -->
        <div class="p-3.5 rounded-xl bg-surface-container flex items-center justify-between border border-outline-variant/20">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-secondary text-[20px]">timer</span>
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Prêt à emporter</span>
                    <span class="font-label-md text-label-md text-on-surface font-semibold">15 à 20 minutes</span>
                </div>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-tertiary-container/20 text-tertiary font-label-sm text-label-sm font-bold flex items-center gap-1 border border-tertiary-container/30">
                <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
                En direct
            </span>
        </div>

        <!-- Order Items List Dynamic Container -->
        <div class="flex flex-col gap-3 max-h-64 overflow-y-auto no-scrollbar py-1" id="cartItemsList">
            <!-- Empty state default -->
            <div class="py-8 flex flex-col items-center justify-center text-center gap-2 text-on-surface-variant" id="cartEmptyNotice">
                <span class="material-symbols-outlined text-[36px] text-outline">local_pizza</span>
                <p class="font-body-sm text-body-sm">Votre panier est encore vide.<br/>Choisissez une création cuite au feu de bois.</p>
            </div>
        </div>

        <!-- Promo Code Input -->
        <div class="flex gap-2">
            <input type="text"
                   id="promoCodeInput"
                   placeholder="Code promo ou Club Rico"
                   class="flex-1 px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-outline text-body-sm font-body-sm focus:outline-none focus:ring-1 focus:ring-secondary uppercase tracking-wider border border-outline-variant/20"/>
            <button type="button"
                    id="applyPromoBtn"
                    data-action="apply-promo"
                    class="px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-bright text-secondary font-label-md text-label-md transition-colors font-semibold">
                Appliquer
            </button>
        </div>

        <!-- Price Calculation Area (HT, TVA 10%, Total TTC) -->
        <div class="flex flex-col gap-2 pt-3 border-t border-outline-variant/20">
            <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                <span>Sous-total articles</span>
                <span id="cartSubtotal" class="font-medium text-on-surface">0,00 €</span>
            </div>
            <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                <span>TVA (10%)</span>
                <span id="cartTax" class="font-medium text-on-surface">0,00 €</span>
            </div>
            <div class="flex justify-between font-title text-title text-on-surface font-bold pt-2 border-t border-outline-variant/20">
                <span>Total TTC</span>
                <span class="text-secondary font-display text-headline-sm" id="cartTotal">0,00 €</span>
            </div>
        </div>

        <!-- Action CTA -->
        <div class="flex flex-col gap-2 pt-2">
            <button type="button"
                    id="orderSubmitBtn"
                    disabled
                    data-action="checkout-order"
                    class="w-full py-3.5 px-4 rounded-lg bg-primary-container text-on-primary-container font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 transition-all opacity-50 cursor-not-allowed shadow-[0_4px_16px_rgba(239,101,65,0.3)] ember-glow active:scale-[0.98]">
                <span>Confirmer la Commande</span>
                <span id="orderSubmitPrice" class="font-bold">0,00 €</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <p class="font-label-sm text-label-sm text-center text-on-surface-variant">
                Paiement sécurisé au comptoir ou en ligne
            </p>
        </div>
    </div>

    <!-- Direct Phone Order Card (Hotline officielle Pizza Rico) -->
    <div class="rounded-xl bg-surface-container p-4 flex items-center justify-between gap-3 shadow-sm border border-outline-variant/20">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-secondary text-on-secondary flex items-center justify-center shrink-0 shadow-sm font-bold">
                <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
            </div>
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Commande par téléphone</span>
                <span class="font-label-lg text-label-lg text-on-surface font-bold tracking-wide">05 63 32 14 43</span>
            </div>
        </div>
        <a href="tel:0563321443"
           class="px-3.5 py-1.5 rounded-md bg-surface-container-high hover:bg-secondary hover:text-on-secondary font-label-md text-label-md text-secondary transition-colors font-semibold border border-secondary/30">
            Appeler
        </a>
    </div>
</aside>
