{# templates/Components/menu/carte_ribbon.html.twig #}
<!-- Top Atmospheric Storytelling Ribbon -->
<section class="relative w-full -mt-20 pt-28 pb-16 overflow-hidden bg-gradient-to-b from-surface-container-lowest via-surface-container-low to-background">
    <!-- Radiant Embers Ambient Lights -->
    <div class="absolute -top-32 -left-20 w-96 h-96 rounded-full bg-primary-container/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 -right-32 w-[32rem] h-[32rem] rounded-full bg-secondary-container/15 blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            <!-- Left Editorial Text Content -->
            <div class="lg:col-span-8 flex flex-col gap-6">
                <!-- Badges de Tradition -->
                <div class="flex flex-wrap items-center gap-3">
                    <span class="px-3.5 py-1.5 rounded-full bg-primary-container/20 text-primary font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1.5 shadow-sm border border-primary-container/30">
                        <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
                        Four Rôtissoire à 450°C
                    </span>
                    <span class="px-3.5 py-1.5 rounded-full bg-secondary-container/20 text-secondary font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1.5 border border-secondary-container/30">
                        <span class="material-symbols-outlined text-[15px]">hourglass_top</span>
                        Maturation Lente 72h
                    </span>
                    <span class="px-3.5 py-1.5 rounded-full bg-tertiary-container/20 text-tertiary font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1.5 border border-tertiary-container/30">
                        <span class="material-symbols-outlined text-[15px]">verified</span>
                        DOP &amp; Terroirs d'Italie
                    </span>
                </div>

                <!-- Titre H1 Dramatique -->
                <div class="flex flex-col gap-3">
                    <h1 class="font-display text-display lg:text-[4.25rem] text-on-surface leading-[1.08] tracking-tight">
                        La Carte des Créations <br class="hidden sm:inline"/>
                        <span class="font-headline-lg italic font-normal text-secondary">au Feu de Bois</span>
                    </h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
                        Une alchimie artisanale façonnée chaque matin : farines napolitaines bio sélectionnées, levée naturelle de 72 heures pour une digestibilité absolue, ingrédients d'appellation protégée et cuisson vive en 90 secondes à 450°C.
                    </p>
                </div>

                <!-- Micro Quick Facts Banner -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
                    <div class="p-4 rounded-xl bg-surface-container flex flex-col gap-1 shadow-sm border border-outline-variant/20">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Retrait Rapide</span>
                        <span class="font-title text-title text-secondary flex items-center gap-1.5 font-bold">
                            <span class="material-symbols-outlined text-[18px]">schedule</span> 15 - 20 min
                        </span>
                    </div>
                    <div class="p-4 rounded-xl bg-surface-container flex flex-col gap-1 shadow-sm border border-outline-variant/20">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Service Actif</span>
                        <span class="font-title text-title text-tertiary flex items-center gap-1.5 font-bold">
                            <span class="w-2.5 h-2.5 rounded-full bg-tertiary animate-pulse"></span> Fournil Ouvert
                        </span>
                    </div>
                    <div class="col-span-2 sm:col-span-1 p-4 rounded-xl bg-surface-container flex flex-col gap-1 shadow-sm border border-outline-variant/20">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Commandes</span>
                        <span class="font-title text-title text-on-surface flex items-center gap-1.5 font-bold">
                            <span class="material-symbols-outlined text-[18px]">storefront</span> À Emporter
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right Visual Showcase: Four Artisanal & Terroir -->
            <div class="lg:col-span-4 relative">
                <div class="relative w-full aspect-square rounded-2xl overflow-hidden shadow-2xl bg-surface-container-high group border border-outline-variant/30">
                    <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBV9vUwr75BYes7VOSy2GN9_Bba2I0qLZaCU-2Dt68k2huQHo0EH7YBH1DTrt9y_eLgSujqj_-_2owFyGp1pKBWE-usiHyzlpwkjGwBsHe4tIK2yf1E58e4ef1SmUFJkdhDu4z8H_TT7v398RYfjfU29Ah7lA3NY90PW-XUfdUnWtb-z7F-IHK5rVrUzjvxXsEGkyD26QrR1kus6vtQhzKGRuTM-j_P2DZ3bTWaiIHNuT1GmWCaybWYQw"
                         alt="Pizza napolitaine artisanale cuite au four à bois avec cornicione alvéolée et sole à 450°C" />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent"></div>
                    <div class="absolute bottom-5 left-5 right-5 p-4 rounded-xl bg-surface/90 backdrop-blur-md flex items-center justify-between shadow-lg border border-outline-variant/30">
                        <div class="flex flex-col">
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">Four Traditionnel</span>
                            <span class="font-title text-title text-on-surface font-semibold">Castelsarrasin • 82100</span>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-[0_4px_16px_rgba(239,101,65,0.4)]">
                            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">fireplace</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
