{# Template affichant la carte des boissons (canettes 33cl & bouteilles). #}
{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <!-- Hero Section pour la page des boissons -->
    <section class="page-header py-5 mb-4">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="display-4 fw-bold">Nos Boissons</h1>
                    <p class="lead">Canettes 33cl fraîches, Eaux, Bières Bouteilles 33cl &amp; Vins Italiens 75cl</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Carte des Boissons (Canettes & Bouteilles) -->
    <section class="py-4">
        <div class="container">
            {{ include('Components/boissons/carte_studio.html.twig', {boissons: boissons}) }}
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section py-5 mt-4">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 text-center">
                    <h2>Envie de déguster nos pizzas &amp; boissons fraîches ?</h2>
                    <p class="h3">Venez nous rendre visite (proche de la poste) ou appelez-nous :</p>
                    <div class="mt-4 d-inline-flex flex-column align-items-start gap-3 text-start">
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=7bis+place+des+Belges+82100+Castelsarrasin" target="_blank" rel="noopener noreferrer" class="h2 mb-0 text-danger text-decoration-none d-inline-flex align-items-center" aria-label="Ouvrir l'adresse 7bis place des Belges 82100 Castelsarrasin dans Google Maps">
                            <i class="bi bi-house-door me-3 text-center" style="width: 1.25em;" aria-hidden="true"></i>
                            <span>7bis place des Belges 82100 Castelsarrasin</span>
                        </a>
                        <a href="tel:+33563321443" class="h2 mb-0 text-danger text-decoration-none d-inline-flex align-items-center" aria-label="Appeler Pizza Rico au 05 63 32 14 43">
                            <i class="bi bi-telephone me-3 text-center" style="width: 1.25em;" aria-hidden="true"></i>
                            <span>05 63 32 14 43</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
