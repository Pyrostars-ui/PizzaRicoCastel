# Normalisation globale des fins de ligne au format Unix (LF)
* text=auto eol=lf

# Scripts shell, hooks Git et fichiers d'infrastructure Docker
*.sh text eol=lf
.githooks/* text eol=lf
githooks/* text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Fichiers sources et configurations Symfony
*.php text eol=lf
*.twig text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.dist text eol=lf
*.md text eol=lf

# Fichiers binaires exclus de la conversion texte
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
